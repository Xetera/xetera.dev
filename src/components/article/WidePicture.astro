---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  width?: number;
  alt: string;
}

const { props } = Astro;
---

<Image
  class="w-full h-auto rounded"
  src={props.src}
  width={props.width ?? 1024}
  format="webp"
  sizes="(min-width: 500px) 1024px, 500px"
  alt={props.alt ?? ""}
/>
