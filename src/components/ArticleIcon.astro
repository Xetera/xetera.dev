---
import twemoji from "@iconify-json/twemoji/icons.json";

export type Props = {
  name: string;
  id: string;
  variant?: "tile" | "bare";
  class?: string;
};

const { name, id, variant = "tile", class: className } = Astro.props;

type IconSet = {
  width?: number;
  height?: number;
  icons: Record<string, { body: string; width?: number; height?: number }>;
  aliases?: Record<string, { parent: string }>;
};

const set = twemoji as IconSet;
const resolved = set.icons[name] ?? set.icons[set.aliases?.[name]?.parent ?? ""];
if (!resolved) {
  throw new Error(`Unknown twemoji icon "${name}" on article "${id}"`);
}
const width = resolved.width ?? set.width ?? 36;
const height = resolved.height ?? set.height ?? 36;
---

{
  variant === "bare" ? (
    <svg
      class:list={["article-icon-bare not-prose shrink-0", className]}
      viewBox={`0 0 ${width} ${height}`}
      transition:name={`icon-${id}`}
      aria-hidden="true"
      set:html={resolved.body}
    />
  ) : (
    <div
      class:list={[
        "article-icon not-prose relative shrink-0 grid place-items-center w-12 h-12 rounded-xl",
        className,
      ]}
      transition:name={`icon-${id}`}
      aria-hidden="true"
    >
      <svg
        class="article-icon-glyph relative w-7 h-7"
        viewBox={`0 0 ${width} ${height}`}
        set:html={resolved.body}
      />
    </div>
  )
}

<style>
  .article-icon {
    background:
      radial-gradient(
        circle at 30% 25%,
        color-mix(in srgb, var(--body-900) 45%, transparent),
        transparent 55%
      ),
      var(--body-700);
    border: 1px solid var(--body-600);
    box-shadow:
      inset 0 -2px 0 var(--body-600),
      0 1px 2px color-mix(in srgb, var(--text-900) 8%, transparent);
    transform: rotate(-4deg);
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .article-icon-glyph {
    filter: drop-shadow(0 1px 1px color-mix(in srgb, var(--text-900) 25%, transparent));
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(.article-entry:hover) .article-icon {
    transform: rotate(3deg) scale(1.05);
  }

  :global(.article-entry:hover) .article-icon-glyph {
    transform: scale(1.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-icon,
    .article-icon-glyph {
      transition: none;
    }
  }
</style>
